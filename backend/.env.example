# MongoDB Atlas connection string (free M0 tier works fine)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=paper_checker

# --- Primary provider: Groq (tried first — fast, generous free tier) ---
# Get free keys at https://console.groq.com/keys
# Comma-separated list of keys; the client falls back to the next key when one
# is rate-limited. Check https://console.groq.com/docs/models for current model IDs.
GROQ_API_KEYS=your_first_groq_api_key,your_second_groq_api_key
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,gemma2-9b-it

# --- Fallback provider: Gemini (used only once every Groq key/model is exhausted) ---
# Get free keys at https://aistudio.google.com/apikey
GEMINI_API_KEYS=your_first_gemini_api_key,your_second_gemini_api_key
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite

# --- Vision provider: OpenRouter (reads answer-key PDFs and scanned answer sheets) ---
# Neither Groq nor Gemini had a working vision model on this project at setup time
# (Groq: no vision-capable model on the account; Gemini: 0 free-tier quota granted).
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEYS=your_first_openrouter_api_key
OPENROUTER_VISION_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free

CORS_ORIGINS=http://localhost:4200
